# Django / Railway
SECRET_KEY=generate-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=.up.railway.app,your-custom-domain.com
CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
CORS_ALLOWED_ORIGINS=https://your-app.up.railway.app

# Postgres (Railway plugin injects DATABASE_URL)
# DATABASE_URL=postgresql://...
DB_SSL_REQUIRE=true
DB_CONN_MAX_AGE=600

# Redis (REQUIRED in production for cache + Celery queues)
# REDIS_URL=redis://...

# Gunicorn
WEB_CONCURRENCY=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_MAX_REQUESTS=800

# Celery worker tuning
CELERY_PREFETCH=1
CELERY_MAX_TASKS_PER_CHILD=200
CELERY_MAX_MEMORY_KB=250000

# Media volume
MEDIA_ROOT=/data/media
SERVE_MEDIA=true
SECURE_SSL_REDIRECT=true
LOG_LEVEL=INFO

# Local Postgres (only when DATABASE_URL empty)
DB_NAME=nasim_db
DB_USER=nasim_user
DB_PASSWORD=your-local-password
DB_HOST=localhost
DB_PORT=5432

# Nira
NIRA_BASE_URL=
NIRA_OFFICE_USER=
NIRA_OFFICE_PASS=
NIRA_API_TIMEOUT=25
NIRA_ROUTES_CACHE_TTL=180
NIRA_AVAILABILITY_CACHE_TTL=45
NIRA_ENRICH_STATUS_ASYNC=true

# Nira IBE payment (airline pattern) — ask partner for exact URLs
# Placeholders: {ref} {callback} {return_url} {amount}
# NIRA_PAYMENT_REDIRECT_URL=https://apps.example.com/ibe/Payment?ref={ref}&callback={callback}&returnUrl={return_url}
# NIRA_RESERVE_URL=https://apps.example.com/api/Res/Reserve
# NIRA_RESERVATION_LOOKUP_URL=https://apps.example.com/api/Res/Get?ref={ref}
NIRA_CALLBACK_SECRET=
NIRA_CALLBACK_IPS=
NIRA_CALLBACK_SUCCESS_VALUES=1,ok,success,paid,true,yes
NIRA_CALLBACK_FAIL_VALUES=0,nok,failed,fail,cancel,cancelled,false

BOOKING_HOLD_MINUTES=15
BOOKING_SOFT_HOLD_CAP=9

# Email / SMS
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@nasimair.com
ALWAYS_NOTIFY_EMAILS=grifindorekamyar@gmail.com
CHAT_NOTIFICATION_EMAILS=grifindorekamyar@gmail.com
COMPLAINT_NOTIFICATION_EMAILS=grifindorekamyar@gmail.com
ADMIN_BASE_URL=https://your-app.up.railway.app
# Public website URL used in sitemap.xml / canonical / Open Graph
PUBLIC_SITE_URL=https://your-app.up.railway.app
MELLIPAYAMAK_USERNAME=
MELLIPAYAMAK_PASSWORD=
MELLIPAYAMAK_FROM_NUMBER=
WEATHER_API_KEY=
